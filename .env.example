# Copy to .env and fill in what you use. .env is git-ignored. Every value can also be changed in the web UI.

# ---- LLM ----------------------------------------------------------------
# Default provider: claude | openai | gemini  (per question: UI, cli.py --provider, MCP ask(provider=...))
LLM_PROVIDER=claude

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# server-side refusal fallback: "default" (recommended) or "off"
CLAUDE_FALLBACKS=default

# GPT (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_REASONING_EFFORT=low

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# low | medium | high, and how many extra tool calls the LLM may make per answer
LLM_EFFORT=medium
LLM_MAX_TOOL_ROUNDS=4
USE_LLM_ROUTER=true
# previous question/answer pairs used to understand follow-up questions (0 = none)
HISTORY_TURNS=3

# ---- Answer modes ---------------------------------------------------------
# Routes that must not be answered wrong: source-only answers, temperature 0, answers with made-up or
# missing citations are replaced by the sources verbatim. Options: sop_policy, compliance, product_catalog,
# customer_insight, review_evidence, creative, brand, generation, unknown
STRICT_ROUTES=sop_policy,compliance,product_catalog
# temperature for every other route (ignored by models without a temperature parameter, e.g. Claude Opus 5, GPT-5)
LLM_TEMPERATURE=0.5

# ---- Search -------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
# where embedding / rerank models are stored (~3.5 GB); relative paths are inside the project
FASTEMBED_CACHE_PATH=models_cache
# hybrid | dense | bm25
SEARCH_MODE=hybrid
KB_TOP_K=6
REVIEW_TOP_K=5
USE_GLOSSARY=true
RERANK=true
RERANK_CANDIDATES=15
PREFETCH_LIMIT=40

# ---- Scope gates (rerank score 0-1) ------------------------------------
OUT_OF_SCOPE_GATE=0.20
NO_INFO_GATE=0.10
